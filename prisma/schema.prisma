generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  password        String
  university      String   @default("Stanford University")
  phone           String?
  role            String   @default("Student")
  avatarUrl       String?  @db.Text
  verifiedStudent Boolean  @default(true)
  dormLocation    String?
  bio             String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listedItems     Item[]              @relation("SellerItems")
  buyerOrders     RentalTransaction[] @relation("BuyerTransactions")
  sellerOrders    RentalTransaction[] @relation("SellerTransactions")
  sentMessages    Inquiry[]           @relation("SentInquiries")
  receivedMessages Inquiry[]          @relation("ReceivedInquiries")
}

model Item {
  id              String   @id @default(uuid())
  title           String
  description     String   @db.Text
  category        String
  listingType     String
  price           Float?
  rentalRate      Float?
  rentalPeriod    String   @default("daily")
  securityDeposit Float    @default(0)
  condition       String
  images          String   @db.Text
  sellerId        String
  isAvailable     Boolean  @default(true)
  location        String?
  viewsCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller          User                @relation("SellerItems", fields: [sellerId], references: [id], onDelete: Cascade)
  transactions    RentalTransaction[]
  inquiries       Inquiry[]
}

model RentalTransaction {
  id              String   @id @default(uuid())
  itemId          String
  buyerId         String
  sellerId        String
  type            String
  startDate       DateTime?
  endDate         DateTime?
  totalAmount     Float
  depositAmount   Float    @default(0)
  status          String   @default("ACTIVE")
  paymentStatus   String   @default("PAID")
  pickupLocation  String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer           User     @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  seller          User     @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id          String   @id @default(uuid())
  itemId      String
  senderId    String
  receiverId  String
  message     String   @db.Text
  createdAt   DateTime @default(now())

  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sender      User     @relation("SentInquiries", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedInquiries", fields: [receiverId], references: [id], onDelete: Cascade)
}
